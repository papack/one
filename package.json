{
  "name": "@papack/one",
  "description": "an all in one SSR Framework",
  "version": "0.5.0",
  "author": "Matthias Steiner",
  "license": "MIT",
  "repository": "github:papack/one",
  "homepage": "https://github.com/papack/one",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "module": "dist/index.mjs",
  "main": "./dist/index.cjs",
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./html": {
      "types": "./dist/html/index.d.mts",
      "import": "./dist/html/index.mjs",
      "require": "./dist/html/index.cjs"
    },
    "./dom": {
      "types": "./dist/dom/index.d.mts",
      "import": "./dist/dom/index.mjs",
      "require": "./dist/dom/index.cjs"
    },
    "./jsx": {
      "types": "./dist/jsx/index.d.mts",
      "import": "./dist/jsx/index.mjs",
      "require": "./dist/jsx/index.cjs"
    },
    "./layout": {
      "types": "./dist/layout/index.d.mts",
      "import": "./dist/layout/index.mjs",
      "require": "./dist/layout/index.cjs"
    }
  },
  "scripts": {
    "dev": "tsx main.ts",
    "fmt": "prettier --write .",
    "lint": "oxlint",
    "check": "tsc --noEmit",
    "build": "tsdown --concurrency 1"
  },
  "keywords": [],
  "devDependencies": {
    "@types/node": "^26.2.0",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
