{
  "compilerOptions": {
    "types": ["node"],
    "target": "ES2022",
    "module": "ESNext",
    "jsx": "react",
    "jsxFactory": "jsx",
    "jsxFragmentFactory": "fragment",
    "moduleResolution": "Bundler",
    "strict": true,
    "outDir": "dist"
  },
  "exclude": ["node_modules", "dist"]
}
